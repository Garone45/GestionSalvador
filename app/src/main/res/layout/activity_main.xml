<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="#FFFFFF">

    <!-- Título de la App -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Adminsa"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnPedidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pedidos"
        android:textSize="18sp"
        android:padding="16dp"
        app:icon="@drawable/ic_pedido"
        app:iconGravity="start"
        app:iconPadding="11dp"
        app:iconTint="#FFFFFF"/>

    <Button
        android:id="@+id/btnClientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clientes"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="1dp"
        app:icon="@drawable/ic_cliente"
        app:iconGravity="start"
        app:iconPadding="11dp"
        app:iconTint="#FFFFFF" />

    <Button
        android:id="@+id/btnMercaderia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mercadería"
        android:textSize="18sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_mercaderia"
        app:iconGravity="start"
        app:iconPadding="9dp"
        app:iconTint="#FFFFFF"/>



</LinearLayout>