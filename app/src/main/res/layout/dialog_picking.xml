<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_curvas_blancas">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Armado de Pedido"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1B4D3E"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDialogPicking"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnFinalizarArmado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finalizar Armado"
        android:backgroundTint="#1B4D3E"
        android:textColor="@android:color/white"/>

</LinearLayout>