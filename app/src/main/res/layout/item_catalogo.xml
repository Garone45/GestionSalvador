<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp">

    <!-- Cuadrado temporal para la imagen -->
    <View
        android:id="@+id/img_producto_placeholder"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="#E0E0E0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_nombre_producto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Nombre Producto"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/layout_cantidad"
        app:layout_constraintStart_toEndOf="@+id/img_producto_placeholder"
        app:layout_constraintTop_toTopOf="@+id/img_producto_placeholder" />

    <TextView
        android:id="@+id/tv_precio_producto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="$0.00 / kg"
        android:textColor="#666666"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/img_producto_placeholder"
        app:layout_constraintEnd_toStartOf="@+id/layout_cantidad"
        app:layout_constraintStart_toEndOf="@+id/img_producto_placeholder"
        app:layout_constraintTop_toBottomOf="@+id/tv_nombre_producto" />

    <!-- Contenedor del selector de cantidad -->
    <LinearLayout
        android:id="@+id/layout_cantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_curvas_blancas"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_restar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="-"
            android:textColor="#2E7D32"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:gravity="center"
            android:text="0"
            android:textColor="#000000"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btn_sumar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#2E7D32"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>